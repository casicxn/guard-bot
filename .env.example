DISCORD_TOKEN=
DISCORD_CLIENT_ID=
BOT_OWNER_ID=YOUR_DISCORD_USER_ID
# Optional development guild registration; omit for global registration.
# DISCORD_GUILD_ID=
DATABASE_PATH=./data/guard.sqlite
LOG_LEVEL=info
# Console: pretty or json; console language is independent of guild language.
LOG_FORMAT=pretty
LOG_LANGUAGE=tr
# Optional bounded rotating JSON Lines diagnostic files.
LOG_TO_FILE=false
LOG_DIRECTORY=./logs
# Planned Restart Protection is owner-confirmed in the existing Discord panel.
# No additional credential or automatic-on-shutdown setting is required.
# Emergency CLI uses this same environment/database; stop the main runtime first.
ENABLE_MEMBERS_INTENT=false
ENABLE_MESSAGE_CONTENT=false
ENABLE_MESSAGE_MONITORING=false
