{
  "name": "ultimate-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "register": "tsx --env-file=.env src/register.ts",
    "recover": "node --env-file=.env dist/recovery-cli.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.27.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  },
  "description": "Discord security bot with owner-only controls, audit-based protection and durable recovery.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casicxn/guard-bot.git"
  },
  "homepage": "https://github.com/casicxn/guard-bot#readme",
  "bugs": {
    "url": "https://github.com/casicxn/guard-bot/issues"
  }
}
